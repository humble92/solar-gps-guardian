# Solar-Guardian environment template.
# Copy to `.env` (backend, never commit) and mirror production values into
# Modal secrets / Vercel env vars. See docs/implementation.md section 7 (U1-U5).

# --- U1: NASA API key. Retained for a later client. Live DONKI uses
# --- https://ccmc.gsfc.nasa.gov/DONKI-API/get/ and does not send this key.
NASA_API_KEY=

# --- U2: Outbound email for the alert batch (SMTP, app default: Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
# Secret used to sign unsubscribe links (any long random string):
UNSUBSCRIBE_SECRET=

# --- U5: LLM advisory (Baseten primary, Fireworks fallback) ---
BASETEN_API_KEY=
BASETEN_MODEL=
FIREWORKS_API_KEY=
FIREWORKS_MODEL=

# --- U3/U4: wiring (fill after first deploys) ---
# Public base URL of the Modal web endpoints, e.g. https://humble92--solar-gps-guardian-api.modal.run
API_BASE_URL=
# Same value as NEXT_PUBLIC_API_BASE in the Vercel project (frontend/):
NEXT_PUBLIC_API_BASE=

# --- No key needed (leave unset): NOAA SWPC, Kyoto Dst, GFZ Kp,
# --- Leaflet, OSRM, Nominatim. Modal auth lives in ~/.modal.toml, not here.
